# ==============================================================================
# AgriSense AI Agent Environment Configuration Example
# ==============================================================================

# External API Configuration
# Geoapify Geocoding API Key (Get key at https://my.geoapify.com/)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# External Mode: 'live' (real APIs), 'sandbox' (tries live, fallback to synthetic), 'offline' (all synthetic)
EXTERNAL_MODE=live

# Open-Meteo Weather API settings (Open-Meteo requires no key, called natively)
WEATHER_CACHE_TTL_SECONDS=900
DEFAULT_FORECAST_DAYS=7

# LLM Provider Configuration
LLM_PROVIDER=openai       # Options: 'openai'
OPENAI_MODEL=gpt-4o-mini  # Options: gpt-4o-mini, gpt-4o

# OpenAI Multi-Key Rate Limiter Pool (2 API Keys for high throughput & failover)
OPENAI_API_KEY=your_openai_api_key_1_here
OPENAI_API_KEY_2=your_openai_api_key_2_here

# Alternatively, pass a comma-separated list of keys:
# OPENAI_API_KEYS=key1,key2

# Backend Service Settings
APP_ENV=sandbox
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Backend URL for Agent Service
AGRISENSE_BACKEND_URL=http://localhost:8000
