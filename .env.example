# ==============================================================================
# AgriSense AI Agent Environment Configuration
# ==============================================================================

# External API Configuration
# Geoapify Geocoding API Key (Get key at https://my.geoapify.com/)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# External Mode: 'live' (real APIs), 'sandbox' (tries live, fallback to synthetic), 'offline' (all synthetic)
EXTERNAL_MODE=live

# Open-Meteo Weather API settings (Open-Meteo requires no key, called natively)
WEATHER_CACHE_TTL_SECONDS=900
DEFAULT_FORECAST_DAYS=7

# LLM Provider Configuration
LLM_PROVIDER=gemini       # Options: 'gemini' or 'openai'
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash # Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash

# OpenAI Alternative (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Backend Service Settings
APP_ENV=sandbox
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Backend URL for Agent Service
AGRISENSE_BACKEND_URL=http://localhost:8000
